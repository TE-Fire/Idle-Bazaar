# ══════════════════════════════════════════════════════════════
# 校园二手交易平台 campus-market
# 覆盖：Windows / VSCode / Java-Maven(Spring Boot) / Node-pnpm-Vite / uni-app
# ══════════════════════════════════════════════════════════════

# ── 操作系统 ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── VSCode ─────────────────────────────────────────────────
# 默认全忽略；只放行「对协作者有意义」的三份：settings/extensions/tasks
# launch.json 不入库：它与本机环境绑定（mainClass、cwd、envFile 指向本地
# 不存在的 .env），每人一份，提交只会互相覆盖
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
.vscode-test/
.history/

# ── 其他 IDE（防止混用 IntelliJ 时污染）────────────────────
.idea/
*.iml
*.ipr
*.iws
out/
.project
.classpath
.settings/

# ── Java / Maven（Spring Boot）─────────────────────────────
target/
build/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.log
*.log.*
hs_err_pid*
replay_pid*
.flattened-pom.xml

# ── Node / pnpm / Vite ─────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml.bak
package-lock.json.bak
dist/
dist-smoke/
dist-ssr/
dist/build/
.vite/
.vite-opt/
.cache/
.temp/
.tmp/
coverage/
*.local
.eslintcache
.stylelintcache
.rpt2_cache/
.serverless/
.webpack/

# ── uni-app / 小程序 ───────────────────────────────────────
unpackage/
.hbuilderx/
.hbuilderx
project.config.json.bak
project.private.config.json

# ── 环境变量与密钥（禁止入库）──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
secrets.yml
application-secret.yml
application-prod.properties

# 环境配置只入库「基础 + 演示」两份：
#   application.yml       基础（无凭据）
#   application-demo.yml  演示（localhost + 演示凭据，供他人复现）
# dev / prod 含个人与真实凭据，一律忽略
application-dev.yml
application-prod.yml
!application-demo.yml

# ── 项目本地产物与运行时数据 ───────────────────────────────
# 锚定到仓库根：无锚定的 storage/ 会匹配到任何层级的 storage 目录，
# 曾把 backend/campus-support/src/main/java/com/campus/support/storage/
# 整个 Java 包吞掉导致模块从未入过库，根目录以外真有运行时数据再按需加规则
/uploads/
/storage/
**/logs/
/logs/
# dev.ps1 启动的进程 PID（本机运行时状态）
/.run/
*.sql.bak
dump-*.sql
*.dump
docker-data/
.workbuddy/

# 开题答辩 PPT 工程：过程中截图、导出件与生成的 SVG 体积大且可重建，
# 只留在本机，不随代码入库
/campus-market/ppt/
